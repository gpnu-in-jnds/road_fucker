execute_process(COMMAND "${FIXTURE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot generate CLI fixtures")
endif()
foreach(scene IN ITEMS straight end close_end unknown)
  if(scene STREQUAL "straight")
    set(expected STRAIGHT)
  elseif(scene STREQUAL "unknown")
    set(expected UNKNOWN)
  else()
    set(expected ROAD_END)
  endif()
  execute_process(COMMAND "${APP}" --source "cli_${scene}.png" --config cli_config.yaml
    --threads 2 --no-display --no-serial --json --full-process
    --overlay "cli_${scene}_process.png" --mask "cli_${scene}_mask.png"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0 OR NOT output MATCHES "\"type\":\"${expected}\"")
    message(FATAL_ERROR "${scene}: ${result}\n${output}\n${errors}")
  endif()
  if(output MATCHES "junction|directions|LEFT_TURN|RIGHT_TURN|T_JUNCTION")
    message(FATAL_ERROR "Legacy classification leaked into JSON: ${output}")
  endif()
  if(NOT EXISTS "cli_${scene}_process.png" OR NOT EXISTS "cli_${scene}_mask.png")
    message(FATAL_ERROR "Missing headless exports for ${scene}")
  endif()
endforeach()
execute_process(COMMAND "${APP}" --source cli_end.png --config cli_config.yaml
  --no-display --no-serial --benchmark 5 RESULT_VARIABLE result ERROR_VARIABLE report)
if(NOT result EQUAL 0 OR NOT report MATCHES "frames 5")
  message(FATAL_ERROR "Benchmark failed: ${report}")
endif()
